<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-mail-Message-textContent')]" position="replace">
            <div class="o-mail-Message-textContent">
                <t t-if="isA2UI">
                    <t t-component="'A2UIGraph'" data="a2uiData.data" summary="a2uiData.summary"/>
                </t>
                <t t-else="">
                    <t t-out="props.message.body"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>