<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ai_tool_add_to_cart" model="ai.tool">
            <field name="name">add_to_cart</field>
            <field name="description">Usa esta herramienta cuando el usuario pida añadir uno o varios productos a su carrito de compras o cesta. Debes haber identificado previamente los IDs de los productos mediante la búsqueda en el catálogo.</field>
            <field name="model_id" ref="mail.model_mail_thread"/>
            <field name="method_name">ai_action_add_to_cart</field>
            
            <field name="parameter_ids">
                <record id="param_product_ids" model="ai.tool.parameter">
                    <field name="name">product_ids</field>
                    <field name="type">array</field>
                    <field name="description">Lista de IDs técnicos (IDs de la base de datos) de los productos a añadir.</field>
                    <field name="required" eval="True"/>
                </record>
            </field>
        </record>
    </data>
</odoo>